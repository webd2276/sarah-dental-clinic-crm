      "parameters": {
        "jsCode": "const toolCall = $('Webhook: check-availability').first().json.body.message.toolCalls[0];\nconst date = toolCall.function['arguments'].date;\n\nconst events = items.map(i => i.json).filter(e => {\n  const eventDate = (e.start.dateTime || e.start.date).slice(0, 10);\n  return eventDate === date;\n});\n\nconst busy = events.map(e => ({\n  start: new Date(e.start.dateTime || e.start.date),\n  end: new Date(e.end.dateTime || e.end.date)\n}));\n\nconst slots = [];\nfor (let h = 9; h < 18; h++) {\n  for (const m of [0, 30]) {\n    const slotStart = new Date(`${date}T${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:00`);\n    const slotEnd = new Date(slotStart.getTime() + 30 * 60000);\n    const overlaps = busy.some(b => slotStart < b.end && slotEnd > b.start);\n    if (!overlaps) slots.push(`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`);\n  }\n}\n\nreturn [{\n  json: {\n    results: [\n      {\n        toolCallId: toolCall.id,\n        result: slots.length ? `Available slots: ${slots.join(', ')}` : \"No slots available that day.\"\n      }\n    ]\n  }\n}];"
