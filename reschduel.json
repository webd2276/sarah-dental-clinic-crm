    {
      "parameters": {
        "jsCode": "// Normalize phone numbers and match on the last 8 digits so that\n// country codes, +, spaces, dashes and leading zeros do not break the lookup.\nconst args = $('Extract Args').first().json;\nconst targetTail = String(args.phone_number || '').replace(/\\D/g, '').slice(-8);\n\nif (!targetTail) { return []; }\n\nconst matches = $input.all().filter(item => {\n  const p = String(item.json.Phone || '').replace(/\\D/g, '').slice(-8);\n  return p && p === targetTail;\n});\n\nreturn matches.map(item => ({\n  json: {\n    ...item.json,\n    toolCallId: args.toolCallId,\n    action: args.action,\n    new_date: args.new_date,\n    new_time: args.new_time,\n    event_id: item.json.event_id || item.json.Event_id || item.json.EventId || '',\n    email: item.json.email || item.json.Email || ''\n  }\n}));"
      },
